.secao {
    min-height: 100vh;
    padding: 120px 70px 70px;
    background: #050814;
    display: flex;
    align-items: center;
}

.secao-alternada {
    background: #080d1d;
}

.conteudo {
    width: 1120px;
    margin: 0 auto;
}

.hero {
    min-height: 100vh;
    background: #050814 url("imagens/fazenda-espacial.png") center right / cover no-repeat;
}

.hero-conteudo {
    margin-left: 0;
    width: 650px;
}

.etiqueta {
    margin-bottom: 18px;
    color: #ff6a2a;
    font-family: "Orbitron", Arial, sans-serif;
    font-size: 14px;
    font-weight: 700;
}